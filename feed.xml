---
published: TRUE
---
<?xml version="1.0" encoding="utf-8"?>{% assign posts = site.posts | sort: 'updated' | reverse %}
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{site.data.x.company}}</title>
<updated>{{posts[0].updated | date_to_xmlschema}}</updated>
<id>{{site.url}}/</id>
<link href="{{site.url}}/"/>
<link href="{{site.url}}/feed.xml" rel="self"/>
<rights type="text">© {{site.data.x.company}}</rights>
<author>
	<name>{{site.data.x.name}}</name>
	<uri>{{site.url}}{{site.data.x.abouturl}}</uri>
</author>
{% for post in posts %}<entry>
	<id>{{site.url}}{{post.id}}</id>
	<title type="text">{% if post.title_br %}{% for title in post.title_br %}{{title}}{% unless forloop.last %} {% endunless %}{% endfor %}{% if post.title_sub %} {{post.title_sub}}{% endif %}{% else %}{{post.title}}{% endif %}</title>
	<updated>{% if post.updated != null %}{{post.updated | date_to_xmlschema}}{% else %}{{post.date | date_to_xmlschema}}{% endif %}</updated>
	<published>{{post.date | date_to_xmlschema}}</published>
	<summary type="text">{{post.description}}</summary>
	<link href="{{site.url}}{{post.url}}" rel="alternate"/>
	<author>
		<name>{{site.data.x.name}}</name>
		<uri>{{site.url}}/about-C-David-Maxey/</uri>
	</author>
</entry>{% endfor %}
</feed>