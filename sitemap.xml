<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% assign sortedpages = site.pages | sort: 'sitemap' | reverse %}
{% for page in sortedpages %}{% if page.sitemap %}<url>
	<loc>{{site.url}}{{page.url | remove: 'index.html'}}</loc>
	<priority>{{page.sitemap}}</priority>
</url>{% endif %}{% endfor %}{% assign posts = site.posts | sort: 'updated' | reverse %}
{% for post in posts %}<url>
	<loc>{{site.url}}{{post.url}}</loc>
	<lastmod>{% if post.updated %}{{post.updated | date_to_xmlschema}}{% else %}{{post.date | date_to_xmlschema}}{% endif %}</lastmod>
	<priority>{% if post.sitemap %}{{post.sitemap}}{% else %}0.5{% endif %}</priority>
</url>{% endfor %}
</urlset>